{
  // TWIST RUSH サーバー（アカウント・クラウドセーブ・ゴールドコイン・ランキング）
  // GitHub の twistrush リポジトリの server フォルダから、Cloudflare Workers Builds で自動公開する
  "name": "twistrush-server",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // サーバーの住所（twistrush.com は Cloudflare のドメインなので、公開すると自動でつながる）
  "routes": [{ "pattern": "api.twistrush.com", "custom_domain": true }],
  // データベース（D1）。はじめての公開のときに自動で作られる
  "d1_databases": [{ "binding": "DB", "database_name": "twistrush-db" }],
  // ダッシュボードで入れた秘密の値（ログイン用のIDなど）を、公開のたびに消さない
  "keep_vars": true,
  // 対戦の部屋（Room）と、相手さがし（Lobby）。無料プランで使える SQLite 型の Durable Object
  "durable_objects": { "bindings": [ { "name": "ROOM", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] } ],
  "vars": {
    "RETURN_ORIGINS": "https://twistrush.com,https://www.twistrush.com,http://localhost:8788",
    "ALLOW_ORIGINS": "https://twistrush.com,https://www.twistrush.com,http://localhost:8788",
    "MAX_SCORE_PER_BLOCK": "1000",
    "MIN_SEC_PER_BLOCK": "0.12",
    "RANK_TZ_HOURS": "9",
    "DEV_LOGIN": "0",
    // ゲスト登録（ログインなしでランキングに載る）。本番でログインだけにするときは "0" にする
    "GUEST_SIGNUP": "1",
    "DUMMY_RANK": "0"
  },
  // テスト用サーバー（staging ブランチ → api-staging.twistrush.com）。データベースも本番とは別
  // 公開コマンド：npx wrangler deploy --env staging
  "env": {
    "staging": {
      "name": "twistrush-server-staging",
      "routes": [{ "pattern": "api-staging.twistrush.com", "custom_domain": true }],
      "d1_databases": [{ "binding": "DB", "database_name": "twistrush-db-staging" }],
      "durable_objects": { "bindings": [ { "name": "ROOM", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" } ] },
      "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] } ],
      "vars": {
        "RETURN_ORIGINS": "https://staging.twistrush.com,http://localhost:8788",
        "ALLOW_ORIGINS": "https://staging.twistrush.com,http://localhost:8788",
        "MAX_SCORE_PER_BLOCK": "1000",
        "MIN_SEC_PER_BLOCK": "0.12",
        "RANK_TZ_HOURS": "9",
        "DEV_LOGIN": "0",
        "GUEST_SIGNUP": "1",
        "DUMMY_RANK": "0",
        // テスト環境だけ：端末のゴールド（テスト用）での人気投票を受け付ける
        "VOTE_TEST": "1"
      }
    }
  }
}
